{
	"name": "fincheck-api",
	"version": "1.0.0",
	"main": "index.js",
	"engines": {
		"node": ">=20.6.0"
	},
	"scripts": {
		"build": "tsc && tsc-alias",
		"watch": "tsc && (concurrently \"tsc -w\" \"tsc-alias -w\")",
		"start": "node --env-file=.env dist/src/servers/index.js",
		"start:dev": "node --watch --watch-preserve-output --env-file=.env dist/src/servers/index.js",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:drop": "drizzle-kit drop",
		"lint": "eslint '**/src/**/*.{ts,tsx}' --fix"
	},
	"type": "module",
	"keywords": [],
	"author": "Wayne Souto<soutowhs@gmail.com>",
	"license": "ISC",
	"dependencies": {
		"@fastify/auth": "^5.0.2",
		"@fastify/compress": "^8.0.1",
		"@fastify/cookie": "^11.0.1",
		"@fastify/cors": "^10.0.2",
		"@fastify/jwt": "^9.0.2",
		"@vinejs/vine": "^3.0.0",
		"ajv": "^8.17.1",
		"ajv-keywords": "^5.1.0",
		"bcryptjs": "^2.4.3",
		"date-fns": "^4.1.0",
		"drizzle-orm": "^0.38.3",
		"eslint": "^9.17.0",
		"fastify": "^5.2.0",
		"nanoid": "^5.0.9",
		"postgres": "^3.4.5"
	},
	"devDependencies": {
		"@specter-labs/eslint-config": "^1.0.8",
		"@types/bcryptjs": "^2.4.6",
		"@types/date-fns": "^2.6.3",
		"@types/node": "^22.10.2",
		"concurrently": "^9.1.1",
		"drizzle-kit": "^0.30.1",
		"tsc-alias": "^1.8.10",
		"typescript": "^5.7.2"
	}
}